<idea-plugin>
    <id>pl.rafapp.assistant.plugin</id>
    <name>AI Coding Assistant</name>
    <vendor>RafaL</vendor>

    <depends>com.intellij.modules.platform</depends>

    <depends optional="true" config-file="python-support.xml">com.intellij.modules.python</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="AI Assistant"
                    anchor="right"
                    factoryClass="ui.AssistantToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="AiAssistant.Ask"
                class="actions.OpenAssistantAction"
                text="Ask AI Assistant"
                description="Send selected code to AI assistant">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift A"/>
        </action>
    </actions>
</idea-plugin>